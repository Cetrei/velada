# Supabase Management API (usado por scripts/setup-supabase.ts)
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx

# Opcional. Borra por completo participant_users/sessions/participants
# (cuentas y peleadores) antes de re-sembrar desde participants.yml.
# Requiere el flag --reset-data en el comando ADEMAS de esta env var en
# "yes" (a proposito, doble confirmacion) para evitar un borrado
# accidental. No borra event_state/matches/predictions. Uso:
#   CONFIRM_RESET_DATA=yes bun run scripts/setup-supabase.ts --reset-data
# Dejar vacio/sin usar en el uso normal (bun run setup:db).
CONFIRM_RESET_DATA=

# Generadas automaticamente por scripts/setup-supabase.ts, tambien se
# copian a apps/web/.env
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare (para el workflow de deploy y scripts/setup-cloudflare-secrets.ts)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Panel de gestion de participantes (leidas en runtime, ver
# apps/web/src/lib/session.ts). No hay invitaciones ni magic links: un
# email en esta lista puede loguearse sin password en /panel-login.
# Emails separados por coma con acceso de host al panel.
ADMIN_EMAILS=tu@email.com,amigo@email.com
# Clave compartida adicional que se pide despues del login para entrar
# al panel. Generala vos mismo (ej. `openssl rand -base64 24`) y no la
# compartas en chats, tickets, o cualquier lugar que quede registrado.
PANEL_PASSPHRASE=

# Riot Games API (para el lookup de elo en el panel de participantes).
# Gratis en https://developer.riotgames.com — las dev keys expiran cada
# 24h, para produccion real se necesita una Personal API Key aprobada.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

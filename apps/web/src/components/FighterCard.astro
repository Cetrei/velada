---
import type { Participant } from "@velada/core";

interface Props {
  participant: Participant;
  detailed?: boolean;
}

const { participant, detailed = false } = Astro.props;

const fallbackImg = `https://placehold.co/400x500/0A1428/C8AA6E?text=${encodeURIComponent(participant.nickname)}`;
const imgSrc = participant.photo ?? fallbackImg;

const statBars = participant.stats
  ? [
      { label: "Fuerza", value: participant.stats.strength },
      { label: "Velocidad", value: participant.stats.speed },
      { label: "Resistencia", value: participant.stats.stamina },
      { label: "Toxicidad", value: participant.stats.toxicLevel }
    ]
  : [];
---

<div
  class="group relative bg-lol-cardBg border border-lol-border clip-edges overflow-hidden transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_15px_30px_rgba(200,170,110,0.15)]"
>
  <div class="h-64 overflow-hidden relative">
    <div class="absolute inset-0 bg-gradient-to-t from-lol-cardBg via-transparent to-transparent z-10">
    </div>
    <img
      src={imgSrc}
      alt={participant.name}
      loading="lazy"
      onerror={`this.onerror=null;this.src='${fallbackImg}'`}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
    />
  </div>

  <div class="p-6 relative z-20 -mt-12 text-center">
    <span
      class="inline-block px-3 py-1 bg-lol-darkBg border border-lol-gold text-lol-gold text-xs font-bold uppercase tracking-wider mb-4 rounded-sm"
    >
      {participant.mainRole}
    </span>
    <h3 class="font-display text-2xl font-bold text-white uppercase tracking-wide mb-1">
      {participant.name}
    </h3>
    <p class="text-lol-blue italic text-sm mb-4">"{participant.nickname}"</p>

    <div class="flex justify-between items-center border-t border-lol-border/50 pt-4 mt-4">
      <span class="text-slate-400 text-xs uppercase">Rango Actual</span>
      <span class="text-white font-bold text-sm">{participant.lolRank}</span>
    </div>

    {
      detailed && (
        <>
          <div class="flex justify-between items-center border-t border-lol-border/50 pt-4 mt-4">
            <span class="text-slate-400 text-xs uppercase">Campeón Favorito</span>
            <span class="text-white font-bold text-sm">{participant.favChampion}</span>
          </div>

          {participant.description && (
            <p class="text-slate-400 text-sm mt-4 text-left">{participant.description}</p>
          )}

          {statBars.length > 0 && (
            <div class="mt-6 space-y-3 text-left">
              {statBars.map((stat) => (
                <div>
                  <div class="flex justify-between text-xs uppercase text-slate-400 mb-1">
                    <span>{stat.label}</span>
                    <span>{stat.value}</span>
                  </div>
                  <div class="h-2 bg-lol-darkBg rounded-full overflow-hidden border border-lol-border/50">
                    <div
                      class="h-full bg-gradient-to-r from-lol-gold to-yellow-400"
                      style={`width: ${stat.value}%`}
                    />
                  </div>
                </div>
              ))}
            </div>
          )}
        </>
      )
    }
  </div>
</div>

---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { getSession } from "../lib/session";
import { findParticipantByOwner } from "../lib/loadParticipants";
import { fetchEventState } from "../lib/eventState";
import { actions } from "astro:actions";
import ParticipantProfileForm from "../components/ParticipantProfileForm";
import { PAGES } from "@velada/core";

const session = await getSession(Astro.cookies, Astro);

// Editar/crear el perfil requiere estar logueado — si no hay sesion, se
// manda a /inscripcion (login/registro), que ahora es una pagina separada
// de esta. No hay UI de "AuthGate" aca adentro: /mi-perfil asume sesion
// valida, siempre.
if (!session) {
  return Astro.redirect("/inscripcion");
}

const existingParticipant = await findParticipantByOwner(session.userId, Astro.locals);
const eventState = await fetchEventState();

// isAdmin ya viene resuelto en la sesion unificada (ADMIN_EMAILS).
const isAlsoAdmin = session.isAdmin;

/**
 * Cerrar inscripciones solo bloquea la creacion de una ficha nueva (sin
 * fila en participants todavia). Alguien que ya tiene ficha sigue pudiendo
 * editarla — el flag gatea altas nuevas, no ediciones de perfiles
 * existentes. Mismo criterio que tenia /inscripcion antes de separarse.
 */
const registrationsClosedForNewSignup = !eventState.registrationsOpen && !existingParticipant;

const copy = PAGES.miPerfil;
const pageTitle = existingParticipant ? copy.title : copy.titleIncomplete;
---

<Layout title={copy.tabTitle}>
  <section class="pt-32 pb-24 bg-lol-darkBg min-h-screen">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl">
      <div class="text-center mb-8">
        <h1 class="font-display text-4xl font-bold text-white uppercase tracking-wider">
          {registrationsClosedForNewSignup ? copy.closedTitle : pageTitle}
        </h1>
        <div class="h-1 w-16 bg-lol-gold mx-auto mt-6"></div>
        <p class="text-slate-400 mt-4 text-sm max-w-md mx-auto">
          {registrationsClosedForNewSignup
            ? copy.closedSubtitle
            : existingParticipant
              ? copy.subtitleEditProfile
              : copy.subtitleNewProfile}
        </p>
      </div>

      <p class="text-center text-slate-400 text-sm mb-2 flex items-center justify-center gap-2">
        {session.email}
        <form method="POST" action={actions.logoutParticipant} class="inline">
          <button type="submit" class="text-lol-blue hover:underline">
            {copy.logoutCta}
          </button>
        </form>
      </p>
      {isAlsoAdmin && (
        <p class="text-center text-xs text-lol-gold/80 mb-8">
          Esta cuenta tambien tiene acceso de host —{" "}
          <a href="/gestion-roster-x9f2" class="underline hover:text-lol-gold">
            ir al panel
          </a>
        </p>
      )}
      {!isAlsoAdmin && <div class="mb-8" />}

      {
        registrationsClosedForNewSignup ? null : (
          <>
            {!existingParticipant && (
              <p class="text-center text-xs text-lol-gold/90 mb-6 max-w-md mx-auto">
                {copy.incompleteBadge}
              </p>
            )}
            <ParticipantProfileForm client:load existingParticipant={existingParticipant} />
          </>
        )
      }
    </div>
  </section>
</Layout>

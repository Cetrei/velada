---
import Layout from "../../layouts/Layout.astro";
import PlayerCardLive from "../../components/PlayerCardLive";
import MmradarPanel from "../../components/MmradarPanel";
import { getSession, getAdminSession } from "../../lib/session";
import { loadParticipants } from "../../lib/loadParticipants";
import { fetchMatches, fetchPredictionTallies } from "../../lib/matches";
import { fetchTeamMatches } from "../../lib/teamMatches";
import { fetchLikeCounts } from "../../lib/likes";
import MatchResultCard from "../../components/MatchResultCard.astro";
import TeamMatchMiniCard from "../../components/TeamMatchMiniCard.astro";
import PredictionCard from "../../components/PredictionCard";
import FighterLikeButton from "../../components/FighterLikeButton";
import { PAGES, flagForCountry } from "@velada/core";

const { id } = Astro.params;

const participants = await loadParticipants();
const participant = participants.find((p) => p.id === id);

if (!participant) {
  return Astro.rewrite("/404");
}

// El boton "Actualizar" de MmradarPanel se muestra a CUALQUIER visitante
// con sesion (de jugador o de admin de panel), no solo al dueno de este
// perfil -- decision explicita del usuario 2026-08-20: refrescar el
// calculo de mmradar no es "editar mis datos personales", es un
// recalculo que cualquier jugador logueado puede pedir sobre cualquier
// perfil (mismo criterio de permisos que refreshMmradarData en
// actions/index.ts). Solo se bloquea a un visitante sin ninguna sesion.
const [session, adminSession] = await Promise.all([
  getSession(Astro.cookies, Astro),
  getAdminSession(Astro.cookies)
]);
const canUpdateMmradar = !!session || !!adminSession;

const participantsById = Object.fromEntries(participants.map((p) => [p.id, p]));
const allMatches = await fetchMatches();
// TODOS los combates 1v1 donde participa (antes era un solo `.find`, que
// escondia el resto si alguien tenia mas de un 1v1 -- pedido del usuario
// 2026-08-21: cada persona puede tener varios individuales y todos deben
// verse en su ficha). Se ordenan igual que /combates (matchNumber, luego
// createdAt) para que el orden sea consistente en todo el sitio.
const participantMatches = allMatches
  .filter((m) => m.player1Id === participant.id || m.player2Id === participant.id)
  .sort((a, b) => {
    const an = a.matchNumber ?? Number.MAX_SAFE_INTEGER;
    const bn = b.matchNumber ?? Number.MAX_SAFE_INTEGER;
    if (an !== bn) return an - bn;
    return (a.createdAt ?? "").localeCompare(b.createdAt ?? "");
  });

function rivalOf(m: (typeof participantMatches)[number]) {
  return participantsById[m.player1Id === participant.id ? m.player2Id : m.player1Id];
}

// TODOS los rivales de 1v1 de este peleador, cada uno con el id de su
// combate para poder linkear desde DuelRatingCard -- antes solo se
// calculaba firstRival (el primer 1v1), asi que MmradarPanel/DuelRatingCard
// solo mostraban probabilidad contra ese, escondiendo cualquier otro 1v1
// que el peleador tuviera (pedido del usuario 2026-08-21: "cada jugador
// puede tener varios 1 vs 1", y que ese componente este pensado para eso).
const rivals = participantMatches
  .map((m) => {
    const rival = rivalOf(m);
    if (!rival) return null;
    return { name: rival.name, duelRating: rival.duelRating, lolRank: rival.lolRank, matchId: m.id ?? null };
  })
  .filter((r): r is NonNullable<typeof r> => r !== null);

// Combate por equipos donde este peleador participa (si hay varios, el mas
// reciente -- fetchTeamMatches ya devuelve ordenado por created_at desc).
// Se usa junto con participantMatches (1v1) de arriba para decidir si
// mostrar el bloque de "Sin definir" con candado: solo cuando NINGUNO de
// los dos tipos de combate existe todavia para este participante.
const allTeamMatches = await fetchTeamMatches();
const teamMatch =
  allTeamMatches.find((tm) => tm.teamAIds.includes(participant.id) || tm.teamBIds.includes(participant.id)) ?? null;
const hasNoCombatYet = participantMatches.length === 0 && !teamMatch;

// Tallies de pronostico para TODOS los 1v1 del participante a la vez (no
// solo el primero), keyed por match.id. Se pasan directo a PredictionCard
// (mismo componente votable que /pronosticos) en vez de calcular
// porcentajes read-only a mano -- pedido del usuario 2026-08-21: el voto
// tiene que poder cambiarse y tener like desde cualquier lugar donde
// aparezca, incluida la ficha individual, no solo /pronosticos.
const tallies = participantMatches.length > 0 ? await fetchPredictionTallies(participantMatches) : new Map();
const talliesRecord = Object.fromEntries(tallies);
const likeCounts = await fetchLikeCounts();

// Contenido 100% de meme (ver ParticipantSchema.memeTitles/memeIconUrl/
// memeFakeMatch/memeFakeTeamMatch y data/meme-participants.yml): solo
// existe para participantes con excludeFromMatches, y solo se dibuja en
// esta ficha puntual -- nunca en /combates, /sorteo, ni el balanceador de
// equipos. memeTitles/memeIconUrl van directo en el cuadro de MmradarPanel
// (fallback visual cuando no hay datos reales de mmradar, ver ese
// componente) -- este bloque aparte SOLO es para los combates falsos
// (1v1 y por equipo), nunca para icono/titulos.
const hasMemeMatches = participant.excludeFromMatches && Boolean(participant.memeFakeMatch || participant.memeFakeTeamMatch);

const copy = PAGES.fighterDetail;
---

<Layout title={copy.tabTitle(participant.name)}>
  <section class="pt-24 pb-24 bg-lol-darkBg min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <a
        href="/peleadores"
        class="inline-flex items-center gap-2 text-slate-400 hover:text-lol-gold transition-colors text-sm mb-8 mt-8"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        {copy.backCta}
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
        <div class="lg:col-span-2 relative">
          <PlayerCardLive
            client:load
            participantId={participant.id}
            data={{
              name: participant.name,
              nickname: participant.nickname,
              mainRole: participant.mainRole,
              favChampion: participant.favChampion,
              lolRank: participant.lolRank,
              photo: participant.photo,
              banner: participant.banner,
              stats: participant.stats
            }}
            className="clip-edges"
          />
          <div class="mt-4">
            <MmradarPanel
              client:load
              participant={{
                id: participant.id,
                name: participant.name,
                lolUsername: participant.lolUsername,
                lolRank: participant.lolRank,
                performanceRank: participant.performanceRank,
                performanceScores: participant.performanceScores,
                titles: participant.titles,
                mmradarIconUrl: participant.mmradarIconUrl,
                mmradarServer: participant.mmradarServer,
                mmradarLevel: participant.mmradarLevel,
                duelRating: participant.duelRating,
                duelConfidence: participant.duelConfidence,
                mmradarUpdatedAt: participant.mmradarUpdatedAt,
                memeTitles: participant.memeTitles,
                memeIconUrl: participant.memeIconUrl
              }}
              canUpdate={canUpdateMmradar}
              rivals={rivals}
            />
          </div>
          <div class="flex items-center gap-4 mt-4">
            {participant.instagramHandle && (
              <span class="flex items-center gap-1.5 text-slate-300 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg>
                {participant.instagramFollowers ?? participant.instagramHandle}
              </span>
            )}
            {participant.xHandle && (
              <span class="flex items-center gap-1.5 text-slate-300 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                {participant.xFollowers ?? participant.xHandle}
              </span>
            )}
          </div>
        </div>

        <div class="lg:col-span-3">
          {participant.country && (
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">{participant.countryFlag ?? flagForCountry(participant.country)}</span>
            </div>
          )}

          <h1 class="font-display text-4xl md:text-6xl font-bold text-white uppercase tracking-tight mb-2 flex items-center gap-4 flex-wrap">
            {participant.name}
            <FighterLikeButton client:load participantId={participant.id} initialLikes={likeCounts[participant.id] ?? 0} size="lg" />
          </h1>
          <p class="text-lol-blue italic text-lg mb-8">"{participant.nickname}"</p>

          {(participant.country || participant.height || participant.weight) && (
            <div class="grid grid-cols-2 gap-x-8 gap-y-5 bg-lol-cardBg border border-lol-border p-6 mb-8">
              {participant.country && (
                <div>
                  <p class="text-slate-500 text-xs uppercase tracking-wide mb-1">{copy.countryLabel}</p>
                  <p class="text-white font-bold">{participant.country}</p>
                </div>
              )}
              {participant.height && (
                <div>
                  <p class="text-slate-500 text-xs uppercase tracking-wide mb-1">{copy.heightLabel}</p>
                  <p class="text-white font-bold">{participant.height}</p>
                </div>
              )}
              {participant.weight && (
                <div>
                  <p class="text-slate-500 text-xs uppercase tracking-wide mb-1">{copy.weightLabel}</p>
                  <p class="text-white font-bold">{participant.weight}</p>
                </div>
              )}
            </div>
          )}

          {participant.description && <p class="text-slate-300 leading-relaxed mb-8">{participant.description}</p>}

          {hasMemeMatches && (
            <div class="bg-lol-cardBg border border-lol-border p-6 mb-8">
              {participant.memeFakeMatch && (
                <div class="mb-6">
                  <p class="text-slate-500 text-xs uppercase tracking-wide mb-2">Combate 1v1</p>
                  <div class="flex items-center justify-between gap-4 bg-lol-darkBg border border-lol-border p-4">
                    <div class="text-center flex-1">
                      <p class="text-white font-bold">{participant.name}</p>
                      {participant.memeFakeMatch.result === "win" && (
                        <span class="text-lol-gold text-xs uppercase font-bold">Ganador</span>
                      )}
                    </div>
                    <span class="text-lol-blue font-bold text-sm">VS</span>
                    <div class="text-center flex-1">
                      <p class="text-white font-bold">{participant.memeFakeMatch.opponentName}</p>
                      <p class="text-slate-500 text-xs italic">{participant.memeFakeMatch.opponentNickname}</p>
                      {participant.memeFakeMatch.result === "loss" && (
                        <span class="text-lol-gold text-xs uppercase font-bold">Ganador</span>
                      )}
                    </div>
                  </div>
                  {participant.memeFakeMatch.decision && (
                    <p class="text-slate-500 text-xs text-center mt-2">{participant.memeFakeMatch.decision}</p>
                  )}
                </div>
              )}

              {participant.memeFakeTeamMatch && (
                <div>
                  <p class="text-slate-500 text-xs uppercase tracking-wide mb-2">Combate por equipos</p>
                  <div class="grid grid-cols-2 gap-3">
                    <div class="bg-lol-darkBg border border-lol-border p-3">
                      <p class="text-xs uppercase text-slate-400 mb-1">
                        {participant.memeFakeTeamMatch.teamName ?? "Tu equipo"}
                        {participant.memeFakeTeamMatch.result === "win" && <span class="text-lol-gold ml-1">★</span>}
                      </p>
                      <ul class="text-sm text-slate-300 space-y-0.5">
                        <li class="text-white font-bold">{participant.name}</li>
                        {participant.memeFakeTeamMatch.teammateNames.map((name) => (
                          <li>{name}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bg-lol-darkBg border border-lol-border p-3">
                      <p class="text-xs uppercase text-slate-400 mb-1">
                        {participant.memeFakeTeamMatch.rivalTeamName ?? "Rivales"}
                        {participant.memeFakeTeamMatch.result === "loss" && <span class="text-lol-gold ml-1">★</span>}
                      </p>
                      <ul class="text-sm text-slate-300 space-y-0.5">
                        {participant.memeFakeTeamMatch.rivalNames.map((name) => (
                          <li>{name}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              )}
            </div>
          )}

          {!hasMemeMatches && hasNoCombatYet && (
            <div class="flex flex-col items-center justify-center text-center py-12 px-6 bg-lol-cardBg border border-lol-border mb-8">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-lol-gold/70 mb-3">
                <rect x="4" y="11" width="16" height="9" rx="1.5" />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
              </svg>
              <h3 class="font-display text-lg font-bold text-white uppercase tracking-widest mb-1">{copy.noCombatTitle}</h3>
              <p class="text-slate-400 text-sm max-w-sm">{copy.noCombatSubtitle}</p>
            </div>
          )}

          {participantMatches.length > 0 && (
            <div class="space-y-6 mb-8">
              <p class="text-slate-500 text-xs uppercase tracking-wide">
                {PAGES.matches.tab1v1} {participantMatches.length > 1 ? `(${participantMatches.length})` : ""}
              </p>
              {participantMatches.map((m, i) => {
                const rival = rivalOf(m);
                if (!rival) return null;
                const player1 = participantsById[m.player1Id];
                const player2 = participantsById[m.player2Id];
                if (!player1 || !player2) return null;
                const showPrediction = m.predictionsOpen && !m.winnerId;
                return (
                  <div>
                    <MatchResultCard match={m} player1={player1} player2={player2} index={i} />
                    {showPrediction && m.id && (
                      <div class="border border-lol-border border-t-0 rounded-b-xl overflow-hidden">
                        <PredictionCard
                          client:load
                          match={m}
                          player1={player1}
                          player2={player2}
                          initialTally={talliesRecord[m.id] ?? { matchId: m.id, player1Votes: 0, player2Votes: 0, totalVotes: 0 }}
                          initialLikes={likeCounts}
                        />
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          )}

          {teamMatch && (
            <div class="mb-8">
              <p class="text-slate-500 text-xs uppercase tracking-wide mb-3">{PAGES.matches.tabTeams}</p>
              <TeamMatchMiniCard teamMatch={teamMatch} participantsById={participantsById} participantId={participant.id} />
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>

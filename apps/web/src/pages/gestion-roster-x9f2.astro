---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { getAdminSession } from "../lib/session";
import { loadParticipants } from "../lib/loadParticipants";
import { fetchEventState } from "../lib/eventState";
import { fetchMatches } from "../lib/matches";
import { fetchTeamMatches } from "../lib/teamMatches";
import { actions } from "astro:actions";
import AdminTabs from "../components/AdminTabs";
import { PAGES } from "@velada/core";

const adminSession = await getAdminSession(Astro.cookies);
if (!adminSession) {
  return Astro.redirect("/panel-login?error=forbidden");
}

const initialParticipants = await loadParticipants();
const eventState = await fetchEventState();
const initialMatches = await fetchMatches();
const initialTeamMatches = await fetchTeamMatches();
const managerCopy = PAGES.rosterManager;
---

<Layout title={managerCopy.title}>
  <section class="pt-32 pb-24 bg-lol-darkBg min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="font-display text-4xl font-bold text-white uppercase tracking-wider">
          {managerCopy.title}
        </h1>
        <div class="h-1 w-24 bg-lol-gold mx-auto mt-6" />
        <p class="text-slate-400 mt-4 text-sm flex items-center justify-center gap-2">
          {adminSession.email}
          <form method="POST" action={actions.adminLogout} class="inline">
            <button type="submit" class="text-lol-blue hover:underline">
              {managerCopy.logoutCta}
            </button>
          </form>
        </p>
      </div>
      <AdminTabs
        client:load
        initialParticipants={initialParticipants}
        eventState={eventState}
        initialMatches={initialMatches}
        initialTeamMatches={initialTeamMatches}
      />
    </div>
  </section>
</Layout>

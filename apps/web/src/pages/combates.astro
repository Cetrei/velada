---
import Layout from "../layouts/Layout.astro";
import MatchesGate from "../components/MatchesGate";
import TeamMatchesGate from "../components/TeamMatchesGate";
import { loadParticipants } from "../lib/loadParticipants";
import { fetchMatches } from "../lib/matches";
import { fetchTeamMatches } from "../lib/teamMatches";
import { PAGES } from "@velada/core";

const participants = await loadParticipants();
const participantsById = Object.fromEntries(participants.map((p) => [p.id, p]));
// Antes esto filtraba con withOfficialResult (solo matches con winnerId),
// lo que dejaba invisibles en /combates los 1v1 recien salidos del sorteo
// (sin resultado todavia) -- bug reportado por el usuario: el sorteo ya
// habia generado combates pero en ningun lado de la pagina aparecian salvo
// en la ficha de cada peleador. MatchResultCard/MatchesGate ya sabian
// mostrar el estado "Resultado pendiente" (mismo patron que ya usan los
// combates por equipo, que nunca se filtraron por resultado), asi que el
// fix es simplemente no filtrar: se muestran TODOS los combates que
// existen (sorteados o cargados a mano), con o sin resultado.
const officialMatches = await fetchMatches();
const teamMatches = await fetchTeamMatches();

const copy = PAGES.matches;
---

<Layout title={copy.tabTitle}>
  <section class="pt-32 pb-24 bg-lol-darkBg min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-white uppercase tracking-wider">
          {copy.title}
        </h1>
        <div class="h-1 w-24 bg-lol-gold mx-auto mt-6"></div>
        <p class="text-slate-400 mt-6 max-w-xl mx-auto">
          {copy.subtitle}
        </p>
      </div>

      <div class="matches-tabs">
        <input type="radio" name="matches-tab" id="tab-1v1" class="matches-tab-input" checked />
        <input type="radio" name="matches-tab" id="tab-teams" class="matches-tab-input" />

        <div class="matches-tab-labels flex justify-center gap-2 mb-12">
          <label for="tab-1v1" class="matches-tab-label">{copy.tab1v1}</label>
          <label for="tab-teams" class="matches-tab-label">{copy.tabTeams}</label>
        </div>

        <div class="matches-tab-panel" id="panel-1v1">
          <MatchesGate client:load matches={officialMatches} participantsById={participantsById} tabRadioGroup="matches-tab" tabPanelId="tab-1v1" />
        </div>
        <div class="matches-tab-panel" id="panel-teams">
          <TeamMatchesGate client:load teamMatches={teamMatches} participantsById={participantsById} tabRadioGroup="matches-tab" tabPanelId="tab-teams" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .matches-tab-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .matches-tab-label {
    padding: 0.6rem 1.5rem;
    border: 1px solid rgba(200, 170, 110, 0.3);
    color: #94a3b8;
    font-family: var(--font-display, inherit);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s, border-color 0.2s;
    user-select: none;
  }

  .matches-tab-label:hover {
    color: #c8aa6e;
  }

  .matches-tab-panel {
    display: none;
  }

  #tab-1v1:checked ~ .matches-tab-labels label[for="tab-1v1"],
  #tab-teams:checked ~ .matches-tab-labels label[for="tab-teams"] {
    background-color: #c8aa6e;
    border-color: #c8aa6e;
    color: #0a1428;
  }

  #tab-1v1:checked ~ #panel-1v1,
  #tab-teams:checked ~ #panel-teams {
    display: block;
  }
</style>

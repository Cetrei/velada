---
import Layout from "../layouts/Layout.astro";
import RouletteWheel from "../components/RouletteWheel";
import { loadParticipants } from "../lib/loadParticipants";
import { fetchEventState } from "../lib/eventState";

const participants = loadParticipants();
const eventState = await fetchEventState();
---

<Layout title="Sorteo en Vivo - La Velada LoL">
  <section class="pt-32 pb-24 relative overflow-hidden bg-gradient-to-b from-lol-darkBg to-black min-h-screen">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-lol-gold/5 rounded-full blur-[100px] pointer-events-none">
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-white uppercase tracking-wider">
          Sorteo Oficial
        </h1>
        <div class="h-1 w-24 bg-lol-gold mx-auto mt-6"></div>
        <p class="text-slate-400 mt-6 max-w-xl mx-auto">
          La suerte decidirá los cruces. En vivo para todo el mundo.
        </p>
      </div>

      <RouletteWheel
        client:load
        participants={participants}
        rouletteUnlocked={eventState.rouletteUnlocked}
      />
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import PredictionsSection from "../components/PredictionsSection";
import TeamPredictionsSection from "../components/TeamPredictionsSection";
import FighterLikesSection from "../components/FighterLikesSection";
import PredictionsInsights from "../components/PredictionsInsights";
import { loadParticipants } from "../lib/loadParticipants";
import { fetchMatches, openForPredictions, fetchPredictionTallies } from "../lib/matches";
import { fetchTeamMatches, openForTeamPredictions, fetchTeamPredictionTallies } from "../lib/teamMatches";
import { fetchLikeCounts } from "../lib/likes";
import { fetchEventState } from "../lib/eventState";
import { PAGES } from "@velada/core";

const eventState = await fetchEventState();

/**
 * votingEnabled is the host's global switch for the whole "fase de
 * votaciones" (independent of registrations/roulette/event-started). Each
 * match (1v1 or por equipo) still has its own predictionsOpen flag from
 * the admin editor for per-combat control, so when the global phase is
 * off we skip the per-match fetch entirely rather than fetching then
 * hiding. Likes are intentionally NOT gated behind votingEnabled: they're
 * a lightweight "favorito" feature independent of the prediction phase,
 * so fans can like fighters even before the host opens voting -- por eso
 * participants se carga siempre (una sola vez), a diferencia de matches/
 * team_matches que solo se piden si la fase de votaciones esta abierta.
 */
const participants = await loadParticipants();
const participantsById = Object.fromEntries(participants.map((p) => [p.id, p]));

const allMatches = eventState.votingEnabled ? await fetchMatches() : [];
const predictionMatches = eventState.votingEnabled ? openForPredictions(allMatches) : [];
const tallies = eventState.votingEnabled ? await fetchPredictionTallies(predictionMatches) : [];
const talliesRecord = Object.fromEntries(tallies);

const allTeamMatches = eventState.votingEnabled ? await fetchTeamMatches() : [];
const predictionTeamMatches = eventState.votingEnabled ? openForTeamPredictions(allTeamMatches) : [];
const teamTallies = eventState.votingEnabled ? await fetchTeamPredictionTallies(predictionTeamMatches) : [];
const teamTalliesRecord = Object.fromEntries(teamTallies);

const likeCounts = await fetchLikeCounts();

const copy = PAGES.predictions;
---

<Layout title={copy.tabTitle}>
  <section class="pt-32 pb-24 bg-lol-darkBg min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-white uppercase tracking-wider">
          {copy.title}
        </h1>
        <div class="h-1 w-24 bg-lol-gold mx-auto mt-6"></div>
        <p class="text-slate-400 mt-6 max-w-xl mx-auto">
          {copy.subtitle}
        </p>
      </div>

      <div class="mb-14">
        <h2 class="font-display text-xl font-bold text-white uppercase tracking-widest text-center mb-6">
          {copy.insightsTitle}
        </h2>
        <PredictionsInsights
          client:load
          matches={predictionMatches}
          teamMatches={predictionTeamMatches}
          participantsById={participantsById}
          tallies={talliesRecord}
          teamTallies={teamTalliesRecord}
        />
      </div>

      <div class="predictions-tabs">
        <input type="radio" name="predictions-tab" id="ptab-1v1" class="predictions-tab-input" checked />
        <input type="radio" name="predictions-tab" id="ptab-teams" class="predictions-tab-input" />
        <input type="radio" name="predictions-tab" id="ptab-likes" class="predictions-tab-input" />

        <div class="predictions-tab-labels flex justify-center gap-2 mb-12">
          <label for="ptab-1v1" class="predictions-tab-label">{copy.tab1v1}</label>
          <label for="ptab-teams" class="predictions-tab-label">{copy.tabTeams}</label>
          <label for="ptab-likes" class="predictions-tab-label">{copy.tabLikes}</label>
        </div>

        <div class="predictions-tab-panel" id="ppanel-1v1">
          <PredictionsSection
            client:load
            matches={predictionMatches}
            participantsById={participantsById}
            tallies={talliesRecord}
            likeCounts={likeCounts}
          />
        </div>
        <div class="predictions-tab-panel" id="ppanel-teams">
          <TeamPredictionsSection
            client:load
            teamMatches={predictionTeamMatches}
            participantsById={participantsById}
            tallies={teamTalliesRecord}
          />
        </div>
        <div class="predictions-tab-panel" id="ppanel-likes">
          <FighterLikesSection client:load participants={participants} initialCounts={likeCounts} />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .predictions-tab-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .predictions-tab-label {
    padding: 0.6rem 1.5rem;
    border: 1px solid rgba(200, 170, 110, 0.3);
    color: #94a3b8;
    font-family: var(--font-display, inherit);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s, border-color 0.2s;
    user-select: none;
  }

  .predictions-tab-label:hover {
    color: #c8aa6e;
  }

  .predictions-tab-panel {
    display: none;
  }

  #ptab-1v1:checked ~ .predictions-tab-labels label[for="ptab-1v1"],
  #ptab-teams:checked ~ .predictions-tab-labels label[for="ptab-teams"],
  #ptab-likes:checked ~ .predictions-tab-labels label[for="ptab-likes"] {
    background-color: #c8aa6e;
    border-color: #c8aa6e;
    color: #0a1428;
  }

  #ptab-1v1:checked ~ #ppanel-1v1,
  #ptab-teams:checked ~ #ppanel-teams,
  #ptab-likes:checked ~ #ppanel-likes {
    display: block;
  }
</style>

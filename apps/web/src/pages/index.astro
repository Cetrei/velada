---
import Layout from "../layouts/Layout.astro";
import Countdown from "../components/Countdown";
import FighterCard from "../components/FighterCard.astro";
import { loadParticipants } from "../lib/loadParticipants";
import { fetchEventState } from "../lib/eventState";

const participants = loadParticipants();
const eventState = await fetchEventState();

const previewFighters = participants.slice(0, 3);
---

<Layout title="La Velada LoL - Especial Amigos">
  <section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 bg-hero-pattern overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
      <span class="text-lol-blue font-bold tracking-[0.3em] uppercase text-sm mb-4 block">
        El Evento de la Década
      </span>
      <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold text-white uppercase tracking-tight drop-shadow-2xl mb-6">
        El <span class="text-transparent bg-clip-text bg-gradient-to-r from-lol-gold via-yellow-200 to-lol-goldDark">Enfrentamiento</span>
        <br />Final
      </h1>
      <p class="max-w-2xl text-lg md:text-xl text-slate-400 mb-12 font-light">
        {participants.length} combatientes, un solo servidor. La Grieta del Invocador está a punto de
        arder.
      </p>

      <Countdown client:load targetIso={eventState.startTime} />

      <a
        href="#overview"
        class="animate-bounce p-2 rounded-full border border-lol-border bg-lol-cardBg text-lol-gold mt-8"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
      </a>
    </div>
  </section>

  <section id="overview" class="py-24 bg-lol-darkBg border-y border-lol-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="font-display text-4xl md:text-5xl font-bold text-white uppercase tracking-wider">
          Los Peleadores
        </h2>
        <div class="h-1 w-24 bg-lol-gold mx-auto mt-6"></div>
        <p class="text-slate-400 mt-6 max-w-xl mx-auto">
          {participants.length} combatientes confirmados. Aquí un adelanto del roster completo.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        {previewFighters.map((participant) => <FighterCard participant={participant} />)}
      </div>

      <div class="text-center">
        <a
          href="/peleadores"
          class="inline-block px-8 py-3 bg-lol-gold/10 border border-lol-gold text-lol-gold hover:bg-lol-gold hover:text-lol-darkBg transition-all font-bold text-sm tracking-wide uppercase clip-edges"
        >
          Ver el roster completo
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 relative overflow-hidden bg-gradient-to-b from-lol-darkBg to-black">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-lol-gold/5 rounded-full blur-[100px] pointer-events-none">
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h2 class="font-display text-3xl font-bold text-white uppercase tracking-widest mb-4">
        Sorteo Oficial
      </h2>
      <p class="text-slate-400 mb-8">
        {
          eventState.rouletteUnlocked
            ? "El sorteo ya está en vivo. Entra y descubre los cruces en tiempo real."
            : "La suerte decidirá los cruces. El sorteo se transmite en vivo para todos los espectadores."
        }
      </p>
      <a
        href="/sorteo"
        class="inline-block px-8 py-4 bg-gradient-to-r from-lol-gold to-yellow-600 hover:from-yellow-500 hover:to-yellow-400 text-black font-display font-bold text-lg transition-all transform hover:-translate-y-1 shadow-[0_10px_20px_rgba(200,170,110,0.3)] clip-edges uppercase tracking-wider"
      >
        {eventState.rouletteUnlocked ? "Entrar al sorteo en vivo" : "Ver estado del sorteo"}
      </a>
    </div>
  </section>
</Layout>

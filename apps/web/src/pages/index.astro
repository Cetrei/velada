---
import Layout from "../layouts/Layout.astro";
import HeroBanner from "../components/HeroBanner.astro";
import Countdown from "../components/Countdown";
import ChampionSelectGrid from "../components/ChampionSelectGrid";
import PredictionsSection from "../components/PredictionsSection";
import LandingCombatesGate from "../components/LandingCombatesGate";
import LandingRaffleCta from "../components/LandingRaffleCta";
import { loadParticipants } from "../lib/loadParticipants";
import { fetchEventState } from "../lib/eventState";
import { fetchMatches, withOfficialResult, openForPredictions, fetchPredictionTallies } from "../lib/matches";
import { fetchTeamMatches } from "../lib/teamMatches";
import { PAGES, SITE } from "@velada/core";   // <-- agregué SITE

const participants = await loadParticipants();
const eventState = await fetchEventState();
const allMatches = await fetchMatches();
const teamMatches = (await fetchTeamMatches()).slice(0, 3);
const raffleMatches = allMatches.filter((m) => m.isRandom);

const participantsById = Object.fromEntries(participants.map((p) => [p.id, p]));
const rivalByParticipantId = Object.fromEntries(
  allMatches.flatMap((m) => [
    [m.player1Id, participantsById[m.player2Id]],
    [m.player2Id, participantsById[m.player1Id]]
  ])
);

const officialMatches = withOfficialResult(allMatches).slice(0, 3);
const predictionMatches = openForPredictions(allMatches).slice(0, 4);
const tallies = await fetchPredictionTallies(predictionMatches);
const talliesRecord = Object.fromEntries(tallies);

const { predictions, home } = PAGES;
---

<Layout title={home.tabTitle}>
  <div class="snap-y snap-mandatory overflow-y-auto h-full scroll-smooth" style="scroll-padding-top: 4rem;">
    <HeroBanner participants={participants} hero={home.hero}>
      <Countdown client:load targetIso={eventState.startTime} />
    </HeroBanner>

    <section id="roster" class="h-screen snap-start flex flex-col items-center justify-center bg-lol-darkBg border-y border-lol-border py-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full min-h-full flex flex-col items-center justify-center gap-4">
        <div class="w-full flex items-center justify-center">
          <ChampionSelectGrid client:load participants={participants} rivalByParticipantId={rivalByParticipantId} />
        </div>
        <div class="text-center flex-shrink-0">
          <a href="/peleadores" class="inline-block px-8 py-3 bg-lol-gold/10 border border-lol-gold text-lol-gold hover:bg-lol-gold hover:text-lol-darkBg transition-all font-bold text-sm tracking-wide uppercase clip-edges">
            {home.overview.cta}
          </a>
        </div>
      </div>
    </section>

    {
      predictionMatches.length > 0 && (
        <section id="pronosticos" class="h-screen snap-start flex items-center justify-center bg-black overflow-hidden">
          <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full max-h-full overflow-y-auto">
            <div class="text-center mb-10">
              <h2 class="font-display text-4xl md:text-5xl font-bold text-white uppercase tracking-wider">{home.predictions.title}</h2>
              <div class="h-1 w-24 bg-lol-gold mx-auto mt-6" />
              <p class="text-slate-400 mt-6 max-w-xl mx-auto">{home.predictions.subtitle}</p>
            </div>
            <PredictionsSection client:load matches={predictionMatches} participantsById={participantsById} tallies={talliesRecord} />
            <div class="text-center mt-8">
              <a href="/pronosticos" class="inline-block px-8 py-3 bg-lol-gold/10 border border-lol-gold text-lol-gold hover:bg-lol-gold hover:text-lol-darkBg transition-all font-bold text-sm tracking-wide uppercase clip-edges">
                {home.predictions.cta}
              </a>
            </div>
          </div>
        </section>
      )
    }

    <section id="combates" class="h-screen snap-start flex items-center justify-center bg-lol-darkBg border-y border-lol-border overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full max-h-full overflow-y-auto">
        <div class="text-center mb-10">
          <h2 class="font-display text-4xl md:text-5xl font-bold text-white uppercase tracking-wider">{home.matches.title}</h2>
          <div class="h-1 w-24 bg-lol-gold mx-auto mt-6" />
          <p class="text-slate-400 mt-6 max-w-xl mx-auto">{home.matches.subtitle}</p>
        </div>

        {
          officialMatches.length === 0 && teamMatches.length === 0 ? (
            <div class="combates-locked flex flex-col items-center justify-center text-center py-16 px-6 border border-lol-border/60 bg-black/20">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-lol-gold/70 mb-4">
                <rect x="4" y="11" width="16" height="9" rx="1.5" />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
              </svg>
              <h3 class="font-display text-xl md:text-2xl font-bold text-white uppercase tracking-widest mb-2">{home.matches.lockedTitle}</h3>
              <p class="text-slate-400 max-w-md">{home.matches.lockedSubtitle}</p>
            </div>
          ) : (
            <LandingCombatesGate
              client:load
              officialMatches={officialMatches}
              teamMatches={teamMatches}
              participantsById={participantsById}
            />
          )
        }
      </div>
    </section>

    <section class="h-screen snap-start flex items-center justify-center relative bg-gradient-to-b from-lol-darkBg to-black overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-lol-gold/5 rounded-full blur-[100px] pointer-events-none" />
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 w-full max-h-full overflow-y-auto">
        <h2 class="font-display text-3xl font-bold text-white uppercase tracking-widest mb-4">{home.raffle.title}</h2>
        <LandingRaffleCta client:load rouletteUnlocked={eventState.rouletteUnlocked} raffleMatches={raffleMatches} />
      </div>
    </section>

    <!-- Footer integrado como última sección del snap -->
    <section class="snap-start h-[30vh] flex flex-col items-center justify-center bg-[#02040a] border-t border-lol-border">
      <p class="text-slate-500 text-sm">{SITE.footer(new Date().getFullYear())}</p>
    </section>
  </div>
</Layout>

<style>
  .home-matches-tab-input { position: absolute; opacity: 0; pointer-events: none; }
  .home-matches-tab-label {
    padding: 0.6rem 1.5rem;
    border: 1px solid rgba(200, 170, 110, 0.3);
    color: #94a3b8;
    font-family: var(--font-display, inherit);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s, border-color 0.2s;
    user-select: none;
  }
  .home-matches-tab-label:hover { color: #c8aa6e; }
  .home-matches-tab-panel { display: none; }
  #home-tab-1v1:checked ~ .home-matches-tab-labels label[for="home-tab-1v1"],
  #home-tab-teams:checked ~ .home-matches-tab-labels label[for="home-tab-teams"] {
    background-color: #c8aa6e; border-color: #c8aa6e; color: #0a1428;
  }
  #home-tab-1v1:checked ~ #home-panel-1v1,
  #home-tab-teams:checked ~ #home-panel-teams { display: block; }
</style>
---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { getSession } from "../lib/session";
import AuthGate from "../components/AuthGate";
import { PAGES } from "@velada/core";

const session = await getSession(Astro.cookies, Astro);

// Esta pagina es SOLO login/registro (separado de /mi-perfil, donde se
// completa/edita la ficha de peleador). Alguien que ya tiene sesion no
// tiene nada que hacer aca — se manda directo a /mi-perfil, que a su vez
// decide si mostrar el form de "completar ficha" o el de "editar perfil"
// segun si ya existe una fila en participants.
if (session) {
  return Astro.redirect("/mi-perfil");
}

const copy = PAGES.inscripcion;
---

<Layout title={copy.tabTitle}>
  <section class="pt-32 pb-24 bg-lol-darkBg min-h-screen">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-2xl">
      <div class="text-center mb-12">
        <h1 class="font-display text-4xl font-bold text-white uppercase tracking-wider">
          {copy.title}
        </h1>
        <div class="h-1 w-16 bg-lol-gold mx-auto mt-6"></div>
        <p class="text-slate-400 mt-4 text-sm max-w-md mx-auto">
          {copy.subtitleAuth}
        </p>
      </div>

      <AuthGate client:load />
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import FighterCard from "../components/FighterCard.astro";
import { loadParticipants } from "../lib/loadParticipants";

const participants = loadParticipants();
---

<Layout title="Peleadores - La Velada LoL">
  <section class="pt-32 pb-24 bg-lol-darkBg min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-white uppercase tracking-wider">
          Roster Completo
        </h1>
        <div class="h-1 w-24 bg-lol-gold mx-auto mt-6"></div>
        <p class="text-slate-400 mt-6 max-w-xl mx-auto">
          {participants.length} combatientes listos para la Grieta del Invocador.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {participants.map((participant) => <FighterCard participant={participant} detailed />)}
      </div>
    </div>
  </section>
</Layout>

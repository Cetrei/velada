---
import "../styles/global.css";
import { SITE, NAV } from "@velada/core";
import { getSession } from "../lib/session";

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.defaultDescription } = Astro.props;
const navLinks = NAV.links;
const session = await getSession(Astro.cookies, Astro);

// Detectar si estamos en el landing para cortar el scroll del body
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Oswald:wght@500;700&display=swap" rel="stylesheet" />
  </head>

  <body class:list={[
    "antialiased flex flex-col font-sans",
    isHome ? "h-screen overflow-hidden" : "min-h-screen"
  ]}>
    <nav class="fixed top-0 w-full z-50 bg-lol-darkBg/80 backdrop-blur-md border-b border-lol-border">
      <input type="checkbox" id="mobile-nav-toggle" class="mobile-nav-toggle-input" />

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-3">
          <div class="w-8 h-8 bg-lol-gold rotate-45 flex items-center justify-center">
            <div class="w-6 h-6 bg-lol-darkBg flex items-center justify-center">
              <span class="text-lol-gold font-display font-bold -rotate-45 block">{SITE.logoText}</span>
            </div>
          </div>
          <span class="font-display font-bold text-xl text-white tracking-widest uppercase">{SITE.name}</span>
        </a>

        <div class="hidden md:flex items-center space-x-8">
          {navLinks.map((link) => (
            <a href={link.href} class="text-sm font-medium text-slate-300 hover:text-lol-gold transition-colors">{link.label}</a>
          ))}
          <a href={session ? "/mi-perfil" : "/inscripcion"} class="px-5 py-2 bg-lol-gold/10 border border-lol-gold text-lol-gold hover:bg-lol-gold hover:text-lol-darkBg transition-all font-bold text-sm tracking-wide uppercase clip-edges">
            {session ? NAV.profileCta : NAV.registerCta}
          </a>
        </div>

        <label for="mobile-nav-toggle" class="mobile-nav-burger md:hidden" aria-label="Abrir menu">
          <span class="mobile-nav-burger-line"></span>
          <span class="mobile-nav-burger-line"></span>
          <span class="mobile-nav-burger-line"></span>
        </label>
      </div>

      <div class="mobile-nav-panel md:hidden">
        <div class="flex flex-col px-4 sm:px-6 py-4 gap-1">
          {navLinks.map((link) => (
            <a href={link.href} class="mobile-nav-link">{link.label}</a>
          ))}
          <a href={session ? "/mi-perfil" : "/inscripcion"} class="mt-3 text-center px-5 py-3 bg-lol-gold/10 border border-lol-gold text-lol-gold hover:bg-lol-gold hover:text-lol-darkBg transition-all font-bold text-sm tracking-wide uppercase clip-edges">
            {session ? NAV.profileCta : NAV.registerCta}
          </a>
        </div>
      </div>

      <label for="mobile-nav-toggle" class="mobile-nav-overlay md:hidden" aria-hidden="true"></label>
    </nav>

    <style>
      .mobile-nav-toggle-input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .mobile-nav-burger {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 32px;
        height: 32px;
        cursor: pointer;
        position: relative;
        z-index: 60;
      }

      /* Refuerzo defensivo: si por algun motivo (cache de build viejo,
         CSS externo con mayor especificidad, extension del navegador)
         md:hidden de Tailwind no gana la cascada, esta regla fuerza el
         comportamiento correcto explicitamente en el mismo breakpoint
         que usa el resto del proyecto (md = 768px, sin override en
         tailwind.config.cjs). No cambia el comportamiento si Tailwind ya
         esta funcionando bien -- es un cinturon de seguridad, no un fix
         alternativo. */
      @media (min-width: 768px) {
        .mobile-nav-burger {
          display: none !important;
        }
      }
      @media (max-width: 767px) {
        nav > div.max-w-7xl > div.hidden.md\:flex {
          display: none !important;
        }
      }

      .mobile-nav-burger-line {
        display: block;
        width: 100%;
        height: 2px;
        background: #C8AA6E;
        transition: transform 0.25s ease, opacity 0.2s ease;
      }

      .mobile-nav-panel {
        position: fixed;
        top: 4rem;
        left: 0;
        right: 0;
        background: #0A1428;
        border-bottom: 1px solid rgba(200, 170, 110, 0.3);
        transform: translateY(-8px);
        opacity: 0;
        pointer-events: none;
        transition: transform 0.2s ease, opacity 0.2s ease;
        max-height: calc(100vh - 4rem);
        overflow-y: auto;
        z-index: 55;
      }

      .mobile-nav-link {
        padding: 0.85rem 0.5rem;
        font-size: 0.95rem;
        font-weight: 500;
        color: #cbd5e1;
        border-bottom: 1px solid rgba(200, 170, 110, 0.12);
        transition: color 0.2s ease;
      }

      .mobile-nav-link:hover {
        color: #C8AA6E;
      }

      .mobile-nav-overlay {
        position: fixed;
        inset: 0;
        top: 4rem;
        background: rgba(0, 0, 0, 0.5);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        z-index: 50;
      }

      .mobile-nav-toggle-input:checked ~ .mobile-nav-panel {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
      }

      .mobile-nav-toggle-input:checked ~ .mobile-nav-overlay {
        opacity: 1;
        pointer-events: auto;
      }

      .mobile-nav-toggle-input:checked ~ div .mobile-nav-burger-line:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }
      .mobile-nav-toggle-input:checked ~ div .mobile-nav-burger-line:nth-child(2) {
        opacity: 0;
      }
      .mobile-nav-toggle-input:checked ~ div .mobile-nav-burger-line:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }
    </style>

    <main class:list={["flex-1", isHome ? "overflow-hidden" : ""]}>
      <slot />
    </main>

    {!isHome && (
      <footer class="bg-[#02040a] border-t border-lol-border py-8 text-center text-slate-500 text-sm">
        <p>{SITE.footer(new Date().getFullYear())}</p>
      </footer>
    )}
  </body>
</html>